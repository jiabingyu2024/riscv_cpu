

# =========================
# Vivado generated artifacts (project-local)
# Safe to ignore: regenerable by opening .xpr and rerunning IP/synth/impl
# =========================
fpga/digital_twin/.Xil/
fpga/digital_twin/digital_twin.cache/
fpga/digital_twin/digital_twin.hw/
fpga/digital_twin/digital_twin.ip_user_files/
fpga/digital_twin/digital_twin.runs/
fpga/digital_twin/digital_twin.sim/
fpga/digital_twin/digital_twin.gen/

# Vivado runtime logs (project root)
fpga/digital_twin/*.jou
fpga/digital_twin/*.log
fpga/digital_twin/*.str
fpga/digital_twin/*.pb
fpga/digital_twin/*.wdf

# Vivado transient writeability test files
fpga/**/.hdi.isWriteableTest*.tmp

# =========================
# Optional large bitstream artifacts
# (if you want to version bit/bin/ltx, remove these 3 lines)
# =========================
fpga/**/*.bit
fpga/**/*.bin
fpga/**/*.ltx

# =========================
# Keep source-of-truth files tracked
# =========================
!fpga/digital_twin/digital_twin.xpr
!fpga/digital_twin/digital_twin.srcs/**
!fpga/coe/**