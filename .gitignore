# Conservative ignore rules for this RISC-V CPU / FPGA project.
# Keep source, tests, constraints, IP configuration, and memory images visible.

# -----------------------------------------------------------------------------
# OS / editor noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

.vscode/
.idea/

# -----------------------------------------------------------------------------
# Python local caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------------------------------------------------------
# Local simulation and build outputs
# -----------------------------------------------------------------------------
build/
obj_dir/
sim_build/

*.vcd
*.vcd.gz
*.fst
*.ghw
*.wdb
*.vvp
*.o
*.d

# -----------------------------------------------------------------------------
# Vivado generated files
# -----------------------------------------------------------------------------
.Xil/
**/.Xil/

fpga/**/vivado*.jou
fpga/**/vivado*.log
fpga/**/*.str
fpga/**/*.pb
fpga/**/*.wdf
fpga/**/*.backup.jou
fpga/**/*.backup.log
fpga/**/.hdi.isWriteableTest*.tmp

# Regenerable Vivado project output directories.
fpga/**/*.cache/
fpga/**/*.gen/
fpga/**/*.hw/
fpga/**/*.ip_user_files/
fpga/**/*.runs/
fpga/**/*.sim/
fpga/**/*.Xil/

# Heavy generated implementation artifacts. Remove a pattern if a handoff requires
# committing a specific generated artifact.
fpga/**/*.bit
fpga/**/*.bin
fpga/**/*.ltx

# -----------------------------------------------------------------------------
# Vivado debug scratch under fpga/: ad-hoc Python scripts that dump traces from
# VCD/hex/mem and the trace files they produce. Not used by any RTL or build
# flow; kept locally for debugging only.
# -----------------------------------------------------------------------------
fpga/dump_trace.py
fpga/dump_trace2.py
fpga/parse3.py
fpga/parse_hex.py
fpga/parse_mem.py
fpga/parse_vcd.py
fpga/parse_vcd_clk.py
fpga/test_vcd.py
fpga/trace.txt
fpga/trace_hex.txt


# -----------------------------------------------------------------------------
# Early pure-LUT FPGA prototype, kept locally for reference only — never built
# or imported by the active flow.
# -----------------------------------------------------------------------------
fpga_slow/

# -----------------------------------------------------------------------------
# Explicitly keep project source-of-truth files visible
# -----------------------------------------------------------------------------
!Makefile
!*.md
!scripts/**/*.py

!rtl/**/*.v
!rtl/**/*.sv
!rtl/**/*.svh
!tb/**/*.cpp
!tb/**/*.h
!tb/**/*.hpp
!tb/**/*.v
!tb/**/*.sv
!tb/**/*.svh

!tests/**
!fpga/**/*.xpr
!fpga/**/*.xci
!fpga/**/*.xdc
!fpga/**/*.coe
!fpga/**/*.wcfg
!fpga/**/*.tcl
!fpga/**/*.v
!fpga/**/*.sv
!fpga/**/*.svh
